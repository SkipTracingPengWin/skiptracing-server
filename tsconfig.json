{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "resolveJsonModule": true,

    "declaration": false,

    "experimentalDecorators": false,
    "emitDecoratorMetadata": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
