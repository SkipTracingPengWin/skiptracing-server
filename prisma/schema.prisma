generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  email          String     @unique
  name           String?
  password       String?
  role           Role       @default(ADMIN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  agent          Agent?
  auditLogs      AuditLog[]
  alerts         Alert[] // Deprecated, keep for safety if needed or remove if sure. Better to match new relations:
  sentAlerts     Alert[]    @relation("SentAlerts")
  receivedAlerts Alert[]    @relation("ReceivedAlerts")
}

model Agent {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String       @unique @db.ObjectId
  user           User         @relation(fields: [userId], references: [id])
  name           String
  email          String       @unique
  phone          String?
  location       String?
  cases          Int          @default(0)
  status         AgentStatus  @default(OFFLINE)
  joinedDate     DateTime     @default(now())
  successRate    Float        @default(0.0)
  totalRecovered Float        @default(0.0)
  assignedCases  Assignment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Borrower {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  phone            String?
  email            String?
  address          String?
  location         String?
  loanId           String?
  loanType         String?
  amount           Float                @default(0.0)
  amountNumeric    Float                @default(0.0)
  dueDate          DateTime? // Expected repayment date
  overdue          String?
  overdueDays      Int                  @default(0)
  risk             String? // high, medium, low, critical
  verified         Boolean              @default(false)
  status           BorrowerStatus       @default(ACTIVE)
  lastContact      DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  verifications    Verification[]
  skipTraceResults SkipTraceResult[]
  recoveryActions  RecoveryAction[]
  assignments      Assignment[]
  auditLogs        AuditLog[]
  locations        Location[]
  socialProfiles   SocialMediaProfile[]
  Alert            Alert[]
}

model SocialMediaProfile {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  borrowerId String?   @db.ObjectId
  borrower   Borrower? @relation(fields: [borrowerId], references: [id])
  platform   String
  url        String
  title      String?
  snippet    String?
  metadata   Json?
  createdAt  DateTime  @default(now())
}

model Verification {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  borrowerId  String             @db.ObjectId
  borrower    Borrower           @relation(fields: [borrowerId], references: [id])
  type        VerificationType
  provider    String?
  status      VerificationStatus @default(PENDING)
  result      Json?
  requestedBy String?
  verifiedBy  String?
  // priority    String? // High, Urgent, etc.
  requestedAt DateTime           @default(now())
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model SkipTraceResult {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  borrowerId String   @db.ObjectId
  borrower   Borrower @relation(fields: [borrowerId], references: [id])
  geojson    Json?
  score      Float?
  provider   String?
  createdAt  DateTime @default(now())
}

model Location {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  borrowerId String    @db.ObjectId
  borrower   Borrower  @relation(fields: [borrowerId], references: [id])
  latitude   Float
  longitude  Float
  address    String?
  lastSeen   DateTime?
  confidence String? // High, Medium, Low
  source     String? // Mobile Signal, Social Media
  metadata   Json?
  createdAt  DateTime  @default(now())
}

model Assignment {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  borrowerId String           @db.ObjectId
  borrower   Borrower         @relation(fields: [borrowerId], references: [id])
  agentId    String?          @db.ObjectId
  agent      Agent?           @relation(fields: [agentId], references: [id])
  loanId     String?
  amount     String?
  assignedAt DateTime         @default(now())
  dueDate    DateTime?
  status     AssignmentStatus @default(OPEN)
  priority   String? // High, Medium, Low
  progress   Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alert {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // admin who created message
  adminId String? @db.ObjectId
  admin   User?   @relation("SentAlerts", fields: [adminId], references: [id])

  // target agent
  agentId String @db.ObjectId
  agent   User   @relation("ReceivedAlerts", fields: [agentId], references: [id])

  // related borrower
  borrowerId String?   @db.ObjectId
  borrower   Borrower? @relation(fields: [borrowerId], references: [id])

  title   String
  message String

  type String // info | warning | success

  read Boolean @default(false)

  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
}

model RecoveryAction {
  id         String               @id @default(auto()) @map("_id") @db.ObjectId
  borrowerId String               @db.ObjectId
  borrower   Borrower             @relation(fields: [borrowerId], references: [id])
  type       RecoveryActionType
  priority   String?
  status     RecoveryActionStatus @default(PENDING)
  executedBy String?
  notes      String?
  executedAt DateTime?
  createdAt  DateTime             @default(now())
}

model AuditLog {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?   @db.ObjectId
  actorName  String?
  actorRole  String?
  user       User?     @relation(fields: [actorId], references: [id])
  borrowerId String?   @db.ObjectId
  borrower   Borrower? @relation(fields: [borrowerId], references: [id])
  action     String
  module     String? // Borrowers, Reports, etc.
  details    String?
  status     String? // Success, Failed
  timestamp  DateTime  @default(now())
  createdAt  DateTime  @default(now())
}

model DashboardStats {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  totalBorrowers       Int      @default(0)
  verified             Int      @default(0)
  inRecovery           Int      @default(0)
  activeAgents         Int      @default(0)
  pendingVerifications Int      @default(0)
  slaAlerts            Int      @default(0)
  totalRecovered       String?
  recoveryRate         Float    @default(0.0)
  updatedAt            DateTime @updatedAt
}

model RecoveryTrend {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  month     String
  recovered Int
  target    Int
  year      Int    @default(2025)
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum AgentStatus {
  ONLINE
  OFFLINE
  LEAVE
  BUSY
}

enum BorrowerStatus {
  ACTIVE // Borrower is active and being tracked
  INACTIVE // Borrower is inactive or closed
  SKIPPED // Borrower is difficult to trace (skip trace)
  VERIFIED // Borrower identity is verified
  HIGH_RISK // High risk borrower
  CRITICAL // Very risky, critical attention needed
  CLOSED // Case closed, no action needed
}

enum VerificationType {
  PAN
  AADHAAR
  BANK
  DL
  RC
  VOTER
  PASSPORT
  ADDRESS
  PHONE
  EMAIL
  LIVENESS
  EMPLOYMENT
}

enum VerificationStatus {
  PENDING
  SUCCESS
  FAILED
  VERIFIED
}

enum AssignmentStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  PENDING
}

enum RecoveryActionType {
  SMS
  CALL
  VISIT
  NOTICE_LEGAL
  OTHER
}

enum RecoveryActionStatus {
  PENDING
  SENT
  FAILED
  COMPLETED
}
